{
  "name": "@ravendarque/beta-interpreter",
  "version": "0.0.0",
  "description": "Rule-based interpreter that turns free-text climbing beta into a structured record.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravendarque/beta-interpreter.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./vocabulary/*": "./vocabulary/*"
  },
  "files": [
    "src",
    "types",
    "vocabulary",
    "LICENSE.md",
    "LICENSE-SCHEDULE.md"
  ],
  "scripts": {
    "workbench": "vite",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
